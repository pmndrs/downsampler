{
  "name": "downsampler",
  "version": "0.1.0",
  "description": "GPU texture downsampling for WebGPU: mip chains, Hi-Z (min/max) pyramids, tile reductions and reductions to one value, as generated WGSL compute kernels. Engine agnostic, with a three.js adapter.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/downsampler.git"
  },
  "homepage": "https://github.com/pmndrs/downsampler#readme",
  "bugs": {
    "url": "https://github.com/pmndrs/downsampler/issues"
  },
  "keywords": [ "webgpu", "wgsl", "compute", "mipmaps", "mipmap", "mip-chain", "downsample", "hi-z", "hzb", "depth-pyramid", "spd", "reduction", "three", "threejs" ],
  "sideEffects": false,
  "files": [ "dist", "!dist/**/*.map", "CHANGELOG.md" ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./webgpu": { "types": "./dist/webgpu/index.d.ts", "default": "./dist/webgpu/index.js" },
    "./three": { "types": "./dist/three/index.d.ts", "default": "./dist/three/index.js" },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "webgpu": [ "./dist/webgpu/index.d.ts" ],
      "three": [ "./dist/three/index.d.ts" ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run test:core && npm run test:gpu",
    "test:core": "node --test test/core/*.test.js",
    "test:gpu": "node test/run.js",
    "bench": "npm run build && node test/run.js --bench",
    "lab": "npm run build && node test/serve.js",
    "examples": "npm run build && node test/serve.js",
    "test:examples": "npm run build && node test/examples.js",
    "tools": "npm run build && node test/tools/run.js"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "three": { "optional": true }
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.60",
    "puppeteer": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
